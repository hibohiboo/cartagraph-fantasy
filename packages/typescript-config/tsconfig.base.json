{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    /* Linting */
    "esModuleInterop": true
  }
}
